{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "types": ["node"],
    "allowJs": false,
    "resolveJsonModule": true,
    "lib": ["ES2020", "DOM"],
    "sourceMap": true
  },
  "include": ["src", "examples", "test"],
  "exclude": ["dist", "node_modules"]
}
