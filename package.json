{
  "name": "scrivener-parser",
  "version": "0.1.0",
  "description": "TypeScript parser for Scrivener .scriv projects — binder, RTF content, metadata, compile settings, snapshots.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./archive/node": {
      "import": "./dist/archive/node.js",
      "types": "./dist/archive/node.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dcfvg/scrivener-parser.git"
  },
  "homepage": "https://github.com/dcfvg/scrivener-parser#readme",
  "bugs": {
    "url": "https://github.com/dcfvg/scrivener-parser/issues"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup src/index.ts src/archive/node.ts --format esm --dts",
    "dev": "tsup src/index.ts src/archive/node.ts --watch --format esm --dts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "pack:check": "node -e \"const { spawnSync } = require('node:child_process'); const { tmpdir } = require('node:os'); const { join } = require('node:path'); const result = spawnSync('npm', ['pack', '--dry-run', '--cache', join(tmpdir(), 'scrivener-parser-npm-cache')], { stdio: 'inherit' }); process.exit(result.status ?? 1);\"",
    "demo": "tsx examples/inspect-sample.ts"
  },
  "keywords": [
    "scrivener",
    "parser",
    "rtf",
    "scriv",
    "browser"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "buffer": "^6.0.3",
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.2",
    "plist": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/plist": "^3.0.5",
    "tsup": "^7.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5"
  }
}
